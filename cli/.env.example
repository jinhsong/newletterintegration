# 회사 계정 로그인 시 프로젝트 ID를 요구하는 경우에만 주석을 풀고 실제 값으로 변경합니다.
# GOOGLE_CLOUD_PROJECT=your-company-project-id

# 결과 HTML 위치. 상대경로는 cli 폴더 기준입니다.
LOCAL_OUTPUT_FILE=.\output\monitoring.html

# 선택 설정: 회사 기본 모델을 그대로 쓰려면 빈칸으로 둡니다.
GEMINI_CLI_BIN=gemini
GEMINI_CLI_MODEL=

# 영역별 최대 대기 10분, 일시적 오류는 한 번만 재시도합니다.
GEMINI_CLI_TIMEOUT_MS=600000
GEMINI_CLI_RETRY_MAX=2
