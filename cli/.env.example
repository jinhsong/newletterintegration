# 전체 실행의 결과 HTML 위치. 그룹·카테고리·목 실행은 충돌 방지를 위해 각 기본 파일명을 씁니다.
# LOCAL_OUTPUT_FILE 상대경로는 cli 폴더 기준입니다. 모든 실행에서 위치를 직접 정하는
# --out 상대경로는 run-monitoring.cmd가 있는 newletterintegration 폴더 기준입니다.
LOCAL_OUTPUT_FILE=.\output\monitoring.html

# 선택 설정: PATH의 각 CLI 대신 회사 전용 실행 파일을 쓰려면 절대경로를 넣습니다.
# 공백이나 한글이 있는 경로도 사용할 수 있습니다.
CLAUDE_CLI_BIN=claude
GEMINI_CLI_BIN=gemini
CODEX_CLI_BIN=codex

# 선택 보안 강화: 회사 IT가 승인한 native .exe/.com 절대경로와 SHA-256을 제공한 경우에만 주석을 해제합니다.
# .cmd/.bat 래퍼 해시는 실제 Node/JavaScript payload를 보장하지 못하므로 SHA 고정과 함께 사용할 수 없습니다.
# Claude 업데이트 뒤에는 실행 파일 해시도 달라지므로 IT가 새 값을 확인해야 합니다.
# CLAUDE_CLI_REQUIRE_ABSOLUTE_BIN=1
# CLAUDE_CLI_ALLOWED_SHA256=64자리_SHA256_16진수

# 회사 기본 모델을 그대로 쓰려면 빈칸으로 둡니다.
CLAUDE_CLI_MODEL=
GEMINI_CLI_MODEL=
CODEX_CLI_MODEL=

# 각 CLI 시작·버전·로그인·보안 기능 확인 제한. 회사 PC의 보안 검사 지연을 고려해 기본 60초입니다.
CLAUDE_CLI_PREFLIGHT_TIMEOUT_MS=60000

# Claude 호출 1회당 최대 대기 10분. 일시적 서비스 오류만 재시도합니다.
CLAUDE_CLI_TIMEOUT_MS=600000
CLAUDE_CLI_RETRY_MAX=2

# Gemini CLI / ChatGPT(Codex CLI)에도 같은 범위의 개별 제한을 설정할 수 있습니다.
# Codex는 저장된 ChatGPT OAuth만 허용하며 API key·access token 로그인은 거부합니다.
GEMINI_CLI_PREFLIGHT_TIMEOUT_MS=60000
GEMINI_CLI_TIMEOUT_MS=600000
GEMINI_CLI_RETRY_MAX=2
CODEX_CLI_PREFLIGHT_TIMEOUT_MS=60000
CODEX_CLI_TIMEOUT_MS=600000
CODEX_CLI_RETRY_MAX=2

# 카테고리 1회 조사에서 허용하는 최대 Claude turn 수. 기본 32, 허용 범위 1~50입니다.
# TURN_LIMIT이 반복되고 검색 도구 호출이 정상 진행된 경우에만 신중하게 늘립니다.
CLAUDE_CLI_MAX_TURNS=32

# 전체 실행 제한을 직접 고정하려면 사용합니다. 7200000은 standard 기본인 120분입니다.
# 이 줄을 지우면 fast 60분 / standard 120분 / deep 240분을 자동 적용합니다. 빈 값은 허용되지 않습니다.
# CLAUDE_RUN_TIMEOUT_MS=7200000
# GEMINI_RUN_TIMEOUT_MS=7200000
# CODEX_RUN_TIMEOUT_MS=7200000
