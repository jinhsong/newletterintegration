# 회사 계정 로그인 시 프로젝트 ID를 요구하는 경우에만 주석을 풀고 실제 값으로 변경합니다.
# GOOGLE_CLOUD_PROJECT=your-company-project-id

# 결과 HTML 위치. 상대경로는 cli 폴더 기준입니다.
LOCAL_OUTPUT_FILE=.\output\monitoring.html

# 선택 설정: PATH의 gemini 대신 회사 전용 실행 파일을 쓰려면 절대경로를 넣습니다.
# 공백이나 한글이 있는 경로도 사용할 수 있습니다.
GEMINI_CLI_BIN=gemini

# 회사 기본 모델을 그대로 쓰려면 빈칸으로 둡니다.
GEMINI_CLI_MODEL=

# Gemini CLI 시작·버전 확인 제한. 회사 PC의 보안 검사 지연을 고려해 기본 60초입니다.
GEMINI_CLI_PREFLIGHT_TIMEOUT_MS=60000

# Gemini 호출 1회당 최대 대기 10분. 일시적 오류와 형식 오류는 재시도합니다.
GEMINI_CLI_TIMEOUT_MS=600000
GEMINI_CLI_RETRY_MAX=2

# 전체 조사 최대 45분. 도달하면 완료된 영역만 부분 HTML로 저장합니다.
GEMINI_RUN_TIMEOUT_MS=2700000
