# ── Gemini CLI Enterprise ───────────────────────────────
# 사내 Gemini Code Assist Standard/Enterprise가 연결된 Google Cloud 프로젝트 ID
GOOGLE_CLOUD_PROJECT=your-company-project-id

# ── 사내 SMTP ───────────────────────────────────────────
# 회사 메일 관리자에게 호스트, 포트, TLS, 인증 방식을 확인하세요.
SMTP_HOST=smtp.company.local
SMTP_PORT=587

# 587 + STARTTLS: SMTP_SECURE=false / SMTP_REQUIRE_TLS=true
# 465 + 처음부터 TLS: SMTP_SECURE=true
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# none: 사내 IP 릴레이 / plain 또는 login: 계정 인증
SMTP_AUTH=none
SMTP_USER=
SMTP_PASSWORD=

# TLS 없는 사내 릴레이를 관리자가 명시적으로 승인한 경우에만 true
SMTP_ALLOW_INSECURE=false

MAIL_FROM=trade-monitor@company.com
MAIL_FROM_NAME=통상 모니터링 시스템
MAIL_REPLY_TO=
MAIL_BATCH_SIZE=40

# ── PC 로컬 저장 ────────────────────────────────────────
# 상대경로는 cli 폴더 기준. 절대경로도 허용합니다.
RECIPIENTS_PATH=.\config\recipients.csv
LOCAL_DATA_DIR=.\data
LOCAL_OUTPUT_DIR=.\output
HISTORY_LOOKBACK_DAYS=7
MAX_RECIPIENTS=500

# ── 선택 조정 ───────────────────────────────────────────
GEMINI_CLI_BIN=gemini
GEMINI_CLI_MODEL=
GEMINI_CLI_CONCURRENCY=3
GEMINI_CLI_TIMEOUT_MS=240000
GEMINI_CLI_RETRY_MAX=3
SOURCE_VALIDATE_MAX=40
SOURCE_VALIDATE_CONCURRENCY=5
SOURCE_VALIDATE_TIMEOUT_MS=8000
SMTP_TIMEOUT_MS=30000
