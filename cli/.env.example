# 필요할 때만 cli/.env로 복사합니다. 기본 실행에는 이 파일이 필요 없습니다.
# API 키·계정 비밀번호·인증 토큰은 여기에 넣지 않습니다.
# 회사 Claude CLI의 기존 로그인과 회사 프록시/관리 설정을 사용합니다.

# PATH에서 claude를 찾을 수 없을 때만 실제 설치 경로를 입력합니다.
CLAUDE_CLI_BIN=

# 비워두면 회사 CLI의 기본 모델을 사용합니다.
CLAUDE_CLI_MODEL=

# 기본값: 시작 확인 60초 / 카테고리 10분 / 표준 전체 조사 120분
# CLAUDE_CLI_PREFLIGHT_TIMEOUT_MS=60000
# CLAUDE_CLI_TIMEOUT_MS=600000
# CLAUDE_RUN_TIMEOUT_MS=7200000

# 선택: 보고서 저장 위치. 비워두면 cli/output/monitoring.html
LOCAL_OUTPUT_FILE=
