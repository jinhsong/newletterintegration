# 사내 Gemini Code Assist Standard/Enterprise가 연결된 Google Cloud 프로젝트
GOOGLE_CLOUD_PROJECT=your-company-project-id

# Google Drive for desktop로 동기화된 CLI inbox의 로컬 절대 경로
# 예: G:\내 드라이브\통상모니터링_CLI_INBOX
CLI_INBOX_PATH=G:\내 드라이브\통상모니터링_CLI_INBOX

# 선택 설정
GEMINI_CLI_BIN=gemini
GEMINI_CLI_MODEL=
GEMINI_CLI_CONCURRENCY=3
GEMINI_CLI_TIMEOUT_MS=240000
GEMINI_CLI_RETRY_MAX=3
