# Copy to .env and inject as environment variables (never commit actual secrets).
GAS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GAS_API_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# stdio for local Codex, http for remotely hosted Work connections
MCP_TRANSPORT=stdio
ENABLE_SEND_TOOL=false

# Required for http: existing OAuth provider supporting PKCE and resource audience.
# Public URL must be the exact externally reachable MCP endpoint (including /mcp).
# MCP_PUBLIC_URL=https://trade-mcp.example.com/mcp
# OAUTH_ISSUER=https://YOUR_TENANT.example.com/
# OAUTH_JWKS_URL=https://YOUR_TENANT.example.com/.well-known/jwks.json
# OAUTH_ALLOWED_SUBJECTS=YOUR_EXACT_OAUTH_USER_SUB
# HOST=0.0.0.0
# PORT=8080
